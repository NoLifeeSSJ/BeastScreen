<Window x:Class="BeastScreen.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:BeastScreen.Desktop.Controls"
        Title="BeastScreen" Width="1440" Height="960" MinWidth="820" MinHeight="600" AllowDrop="True" Drop="OnDrop" PreviewKeyDown="OnKeyDown" Closing="OnClosing" Background="#0C1018">
  <Window.Resources><controls:ThumbnailConverter x:Key="Thumbnail" /></Window.Resources>
  <Grid Margin="16">
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition x:Name="QueueColumn" Width="260" /></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition x:Name="LibraryRow" Height="310" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <DockPanel x:Name="Header" Grid.ColumnSpan="3" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button Content="☰" Click="ToggleSidebar" AutomationProperties.Name="Toggle navigation" /><StackPanel Margin="12,0,28,0"><TextBlock Text="BEASTSCREEN" FontWeight="Bold" FontSize="20" /><TextBlock Text="A little more cinema. Everywhere." Foreground="#A3B2C8" FontSize="11" /></StackPanel></StackPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button Content="Open files" Command="{Binding UiCommand}" CommandParameter="files" /><Button Content="Open folder" Command="{Binding UiCommand}" CommandParameter="folder" /><Button Content="Open URL" Command="{Binding UiCommand}" CommandParameter="url" /><Button Content="Queue" Click="ToggleQueue" AutomationProperties.Name="Toggle playlist panel" /></StackPanel>
      <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=250}" MinWidth="120" MaxWidth="480" AutomationProperties.Name="Search library" ToolTip="Search title, artist, album or genre" />
    </DockPanel>
    <Border x:Name="Sidebar" Grid.Row="1" Grid.RowSpan="3" Background="{StaticResource Surface}" CornerRadius="9" Margin="0,0,14,0">
      <DockPanel Margin="10"><StackPanel DockPanel.Dock="Bottom"><Button Content="Add library folder" Command="{Binding UiCommand}" CommandParameter="library" /><Button Content="Rescan folders" Command="{Binding RescanCommand}" /><Button Content="Cancel scan" Command="{Binding CancelScanCommand}" Visibility="{Binding IsScanning, Converter={StaticResource BoolVisibility}}" /></StackPanel><ListBox ItemsSource="{Binding Navigation}" SelectedItem="{Binding View}" AutomationProperties.Name="Navigation" /></DockPanel>
    </Border>
    <Border Grid.Row="1" Grid.Column="1" Background="Black" CornerRadius="9" Margin="0,0,0,8" ClipToBounds="True" MinHeight="150">
      <controls:VideoHost x:Name="Video" Ready="OnVideoReady" NativeKey="OnNativeKey" DoubleClicked="OnVideoDoubleClick" AutomationProperties.Name="Video playback surface" />
    </Border>
    <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource Surface}" CornerRadius="9" Margin="0,0,0,12" Padding="12">
      <StackPanel>
        <DockPanel><TextBlock Text="{Binding TimeLabel}" DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="#A3B2C8" /><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" /></DockPanel>
        <Slider Minimum="0" Maximum="100" Value="{Binding SeekPosition}" IsEnabled="{Binding Seekable}" Margin="0,10,0,6" AutomationProperties.Name="Playback position" />
        <WrapPanel VerticalAlignment="Center">
          <Button Content="Previous" Command="{Binding PreviousCommand}" /><Button Content="−10s" Command="{Binding SeekCommand}" CommandParameter="back" AutomationProperties.Name="Seek backward by configured interval" />
          <Button Content="{Binding PlayLabel}" Command="{Binding PlayPauseCommand}" Background="#286958" MinWidth="78" /><Button Content="+10s" Command="{Binding SeekCommand}" CommandParameter="forward" AutomationProperties.Name="Seek forward by configured interval" /><Button Content="Next" Command="{Binding NextCommand}" /><Button Content="Stop" Command="{Binding StopCommand}" />
          <CheckBox Content="Mute" IsChecked="{Binding Muted}" /><Slider Width="90" Minimum="0" Maximum="100" Value="{Binding Volume}" Margin="6,0" AutomationProperties.Name="Volume" />
          <ComboBox ItemsSource="{Binding Speeds}" SelectedItem="{Binding Speed}" MinWidth="65" AutomationProperties.Name="Playback speed" />
          <Button Content="Fullscreen" Command="{Binding FullscreenCommand}" /><Button Content="Mini" Click="ToggleMini" AutomationProperties.Name="Toggle mini player" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <Border x:Name="PlaylistPanel" Grid.Row="1" Grid.RowSpan="3" Grid.Column="2" Background="{StaticResource Surface}" CornerRadius="9" Margin="14,0,0,0" Padding="10">
      <DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="UP NEXT" Foreground="#85E0CB" FontSize="12" FontWeight="Bold" Margin="8" /><WrapPanel><CheckBox Content="Shuffle" IsChecked="{Binding Shuffle}" /><Button Content="{Binding Repeat, StringFormat=Repeat: {0}}" Command="{Binding CycleRepeatCommand}" /></WrapPanel></StackPanel>
        <StackPanel DockPanel.Dock="Bottom"><WrapPanel><Button Content="↑" Command="{Binding MoveQueueCommand}" CommandParameter="up" AutomationProperties.Name="Move playlist item up" /><Button Content="↓" Command="{Binding MoveQueueCommand}" CommandParameter="down" AutomationProperties.Name="Move playlist item down" /><Button Content="Save" Command="{Binding SaveQueueCommand}" /><Button Content="Export" Command="{Binding UiCommand}" CommandParameter="export" /></WrapPanel><Button Content="Import playlist" Command="{Binding UiCommand}" CommandParameter="import" /></StackPanel>
        <ListBox ItemsSource="{Binding Queue}" SelectedIndex="{Binding SelectedQueueIndex}" MouseDoubleClick="PlayQueued" AutomationProperties.Name="Playback queue"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" /></DataTemplate></ListBox.ItemTemplate></ListBox>
      </DockPanel>
    </Border>
    <TabControl x:Name="LibraryTabs" Grid.Row="3" Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="#38485F">
      <TabItem Header="Library">
        <DockPanel Margin="10">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8"><TextBlock Text="{Binding View}" FontSize="18" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="List / grid" Click="ToggleGrid" /><TextBlock Text="Sort" /><ComboBox ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}" AutomationProperties.Name="Sort library" /><Button Content="Favourite" Command="{Binding FavouriteCommand}" /><Button Content="Play" Command="{Binding PlaySelectedCommand}" /></StackPanel></DockPanel>
          <DockPanel DockPanel.Dock="Bottom"><TextBlock Text="{Binding PageLabel}" Foreground="#A3B2C8" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Previous page" Command="{Binding PreviousPageCommand}" /><Button Content="Next page" Command="{Binding NextPageCommand}" /></StackPanel></DockPanel>
          <Grid>
            <TextBlock Text="Your library starts here. Add a folder or open a file. Only folders you choose are scanned." TextWrapping="Wrap" Foreground="#A3B2C8" Margin="18" Visibility="{Binding LibraryEmpty, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False" VerticalAlignment="Center" />
            <ListBox x:Name="MediaList" ItemsSource="{Binding Library}" SelectedItem="{Binding SelectedMedia}" MouseDoubleClick="PlayLibrary" AutomationProperties.Name="Media library" Background="Transparent">
              <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate><TextBlock Text="{Binding Name}" FontSize="16" Foreground="#85E0CB" Margin="8,12,8,4" /></DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
              <ListBox.ItemTemplate><DataTemplate><DockPanel><Image Source="{Binding Thumbnail, Converter={StaticResource Thumbnail}}" Width="64" Height="42" Stretch="UniformToFill" Margin="0,0,12,0" DockPanel.Dock="Left" /><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Detail}" Foreground="#A3B2C8" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Text="Unavailable — reconnect or relocate this folder" Foreground="#FFBA8A" Visibility="{Binding Missing, Converter={StaticResource BoolVisibility}}" /></StackPanel></DockPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Tracks &amp; picture"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
        <WrapPanel><TextBlock Text="Audio" /><ComboBox Width="190" ItemsSource="{Binding AudioTracks}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedAudio}" AutomationProperties.Name="Audio track" /><TextBlock Text="Subtitles" /><ComboBox Width="190" ItemsSource="{Binding SubtitleTracks}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedSubtitle}" AutomationProperties.Name="Subtitle track" /><Button Content="Load subtitles" Command="{Binding UiCommand}" CommandParameter="subtitle" /></WrapPanel>
        <WrapPanel><TextBlock Text="Video" /><ComboBox Width="150" ItemsSource="{Binding VideoTracks}" DisplayMemberPath="Display" SelectedItem="{Binding SelectedVideo}" AutomationProperties.Name="Video track" /><TextBlock Text="Chapter" /><ComboBox Width="180" ItemsSource="{Binding Chapters}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedChapter}" AutomationProperties.Name="Chapter" /><Button Content="Previous chapter" Click="PreviousChapter" /><Button Content="Next chapter" Click="NextChapter" /><Button Content="Edition" Command="{Binding UiCommand}" CommandParameter="edition" /></WrapPanel>
        <WrapPanel><TextBlock Text="Audio delay (s)" /><TextBox Width="70" Text="{Binding AudioDelay}" AutomationProperties.Name="Audio delay seconds" /><TextBlock Text="Subtitle delay (s)" /><TextBox Width="70" Text="{Binding SubtitleDelay}" AutomationProperties.Name="Subtitle delay seconds" /><Button Content="Frame step" Command="{Binding FrameCommand}" /><Button Content="A–B" Command="{Binding LoopCommand}" /><Button Content="Clear loop" Command="{Binding ClearLoopCommand}" /></WrapPanel>
        <WrapPanel><TextBlock Text="Aspect" /><ComboBox Width="95" SelectedValue="{Binding Aspect}" SelectedValuePath="Content" AutomationProperties.Name="Aspect ratio"><ComboBoxItem Content="-1" /><ComboBoxItem Content="16:9" /><ComboBoxItem Content="4:3" /><ComboBoxItem Content="2.35:1" /></ComboBox><TextBlock Text="Rotation" /><ComboBox SelectedValue="{Binding Rotation}" SelectedValuePath="Content" AutomationProperties.Name="Video rotation"><ComboBoxItem Content="0" /><ComboBoxItem Content="90" /><ComboBoxItem Content="180" /><ComboBoxItem Content="270" /></ComboBox><CheckBox Content="Deinterlace" IsChecked="{Binding Deinterlace}" /><TextBlock Text="Zoom" /><Slider Width="100" Minimum="-2" Maximum="2" Value="{Binding Zoom}" AutomationProperties.Name="Video zoom" /><Button Content="Crop" Command="{Binding UiCommand}" CommandParameter="crop" /><Button Content="Screenshot" Command="{Binding ScreenshotCommand}" /></WrapPanel>
        <WrapPanel><TextBlock Text="Brightness" /><Slider Width="110" Minimum="-100" Maximum="100" Value="{Binding Brightness}" AutomationProperties.Name="Brightness" /><TextBlock Text="Contrast" /><Slider Width="110" Minimum="-100" Maximum="100" Value="{Binding Contrast}" AutomationProperties.Name="Contrast" /><TextBlock Text="Saturation" /><Slider Width="110" Minimum="-100" Maximum="100" Value="{Binding Saturation}" AutomationProperties.Name="Saturation" /><CheckBox Content="Always on top" Checked="OnTopChanged" Unchecked="OnTopChanged" /></WrapPanel>
        <TextBlock Text="{Binding Diagnostics}" TextWrapping="Wrap" Foreground="#A3B2C8" Margin="4,12" />
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Bookmarks &amp; playlists"><StackPanel Margin="14"><WrapPanel><Button Content="Add bookmark" Command="{Binding BookmarkCommand}" /><ComboBox Width="190" ItemsSource="{Binding Bookmarks}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedBookmark}" AutomationProperties.Name="Bookmarks" /><Button Content="Go to bookmark" Command="{Binding GoBookmarkCommand}" /><Button Content="Start again" Command="{Binding RestartCommand}" /><CheckBox Content="Resume playback" IsChecked="{Binding ResumeEnabled}" /></WrapPanel><WrapPanel><ComboBox Width="260" ItemsSource="{Binding SavedPlaylists}" SelectedItem="{Binding SelectedSavedPlaylist}" AutomationProperties.Name="Saved playlists" /><Button Content="Load playlist" Command="{Binding LoadSavedPlaylistCommand}" /><Button Content="Save current queue" Command="{Binding SaveQueueCommand}" /></WrapPanel><WrapPanel><Button Content="Backup library" Command="{Binding UiCommand}" CommandParameter="backup" /><Button Content="Restore library" Command="{Binding UiCommand}" CommandParameter="restore" /><Button Content="Relocate folder" Command="{Binding UiCommand}" CommandParameter="relocate" /><Button Content="Export diagnostics" Command="{Binding UiCommand}" CommandParameter="diagnostics" /></WrapPanel></StackPanel></TabItem>
      <TabItem Header="Settings" x:Name="SettingsTab"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14">
        <TextBlock Text="Playback preferences" FontSize="19" FontWeight="SemiBold" Margin="4,8" /><WrapPanel><TextBlock Text="Hardware decoding" /><ComboBox Width="130" SelectedValue="{Binding Preferences.HardwareDecoding}" SelectedValuePath="Content" AutomationProperties.Name="Hardware decoding"><ComboBoxItem Content="auto-safe" /><ComboBoxItem Content="no" /></ComboBox><TextBlock Text="Seek interval (s)" /><TextBox Width="65" Text="{Binding Preferences.SeekSeconds}" AutomationProperties.Name="Seek interval seconds" /><TextBlock Text="Scaling" /><ComboBox Width="150" SelectedValue="{Binding Preferences.Scale}" SelectedValuePath="Content" AutomationProperties.Name="Video scaling"><ComboBoxItem Content="bilinear" /><ComboBoxItem Content="bicubic" /><ComboBoxItem Content="lanczos" /><ComboBoxItem Content="ewa_lanczossharp" /></ComboBox></WrapPanel>
        <TextBlock Text="Automatic decoding falls back to software when the GPU or driver cannot decode the video. Sharper scaling can use more GPU power." TextWrapping="Wrap" Foreground="#A3B2C8" Margin="4,5" />
        <WrapPanel><TextBlock Text="Tone mapping" /><ComboBox Width="130" SelectedValue="{Binding Preferences.ToneMapping}" SelectedValuePath="Content" AutomationProperties.Name="Tone mapping"><ComboBoxItem Content="auto" /><ComboBoxItem Content="bt.2390" /><ComboBoxItem Content="clip" /><ComboBoxItem Content="reinhard" /></ComboBox><Button Content="HDR output" Command="{Binding UiCommand}" CommandParameter="hdr" /><TextBlock Text="HDR depends on the display, GPU, driver and Windows HDR settings." TextWrapping="Wrap" Foreground="#A3B2C8" /></WrapPanel>
        <WrapPanel><TextBlock Text="Audio language" /><TextBox Width="90" Text="{Binding Preferences.AudioLanguage}" AutomationProperties.Name="Preferred audio language" /><TextBlock Text="Subtitle language" /><TextBox Width="90" Text="{Binding Preferences.SubtitleLanguage}" AutomationProperties.Name="Preferred subtitle language" /><TextBlock Text="Subtitle size" /><TextBox Width="65" Text="{Binding Preferences.SubtitleSize}" AutomationProperties.Name="Subtitle size" /><TextBlock Text="Colour" /><TextBox Width="110" Text="{Binding Preferences.SubtitleColour}" AutomationProperties.Name="Subtitle colour ARGB" /></WrapPanel>
        <WrapPanel><TextBlock Text="Screenshot folder" /><TextBox Width="360" Text="{Binding Preferences.ScreenshotFolder}" AutomationProperties.Name="Screenshot folder" /><TextBlock Text="Audio device" /><TextBox Width="180" Text="{Binding AudioDevice}" AutomationProperties.Name="mpv audio device name" /><Button Content="List devices" Command="{Binding UiCommand}" CommandParameter="devices" /></WrapPanel>
        <WrapPanel><CheckBox Content="Volume normalisation" IsChecked="{Binding Preferences.NormalizeVolume}" /><CheckBox Content="Audio passthrough" IsChecked="{Binding Preferences.Passthrough}" /><TextBlock Text="Requires a compatible receiver and output device." Foreground="#A3B2C8" /></WrapPanel>
        <WrapPanel><TextBlock Text="Equalizer (60, 230, 910, 3600, 14000 Hz gains in dB)" /><TextBox Width="160" Text="{Binding Preferences.Equalizer}" AutomationProperties.Name="Five equalizer gains" /><Button Content="Edit shortcuts" Command="{Binding UiCommand}" CommandParameter="shortcuts" /><Button Content="Apply and save" Command="{Binding SavePreferencesCommand}" Background="#286958" /></WrapPanel>
        <TextBlock Text="Local playback works offline. No accounts, automatic drive scans, external metadata lookups or telemetry. Website extraction and encrypted discs are not enabled." TextWrapping="Wrap" Foreground="#A3B2C8" Margin="4,12" />
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,10,0,0"><TextBlock Text="{Binding Error}" Foreground="#FFBA8A" TextWrapping="Wrap" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}" AutomationProperties.LiveSetting="Polite" /><TextBlock Text="{Binding Status}" Foreground="#A3B2C8" TextTrimming="CharacterEllipsis" FontSize="12" AutomationProperties.LiveSetting="Polite" /></StackPanel>
  </Grid>
</Window>
